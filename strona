    <!-- JavaScript Logic -->
    <script>
        lucide.createIcons();

        function toggleGallery() {
            const grid = document.getElementById('gallery-grid');
            const preview = document.getElementById('preview-container');
            const btn = document.getElementById('show-more-btn');

            if (grid.classList.contains('hidden')) {
                grid.classList.remove('hidden');
                preview.classList.add('hidden');
                btn.innerHTML = '<i data-lucide="eye-off" class="w-4 h-4"></i><span>Pokaż mniej</span>';
            } else {
                grid.classList.add('hidden');
                preview.classList.remove('hidden');
                btn.innerHTML = '<i data-lucide="eye" class="w-4 h-4"></i><span>Pokaż więcej zdjęć</span>';
                window.scrollTo({ top: preview.offsetTop - 100, behavior: 'smooth' });
            }
            lucide.createIcons();
        }

        function copyEmail() {
            const email = "mixwspolpraca@gmail.com";
            const dummy = document.createElement("textarea");
            document.body.appendChild(dummy);
            dummy.value = email;
            dummy.select();
            document.execCommand("copy");
            document.body.removeChild(dummy);

            const toast = document.getElementById('copy-toast');
            toast.classList.remove('opacity-0');
            setTimeout(() => {
                toast.classList.add('opacity-0');
            }, 2000);
        }

        function openLightbox(element) {
            const article = element.closest('article');
            const imgSrc = element.querySelector('img').src;
            const title = article.querySelector('h3').innerText;
            const desc = article.querySelector('p').innerText;

            document.getElementById('lightbox-img').src = imgSrc;
            document.getElementById('lightbox-title').innerText = title;
            document.getElementById('lightbox-desc').innerText = desc;

            const modal = document.getElementById('lightbox');
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox(event) {
            if (event.target.id === 'lightbox') forceCloseLightbox();
        }

        function forceCloseLightbox() {
            const modal = document.getElementById('lightbox');
            modal.classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') forceCloseLightbox();
        });
    </script>
